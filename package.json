{
  "name": "queue-list",
  "version": "2.0.0",
  "description": "A fast, dependency-free FIFO queue (linked list) for JavaScript with O(1) enqueue/dequeue, iteration support and TypeScript types",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "test": "node --test",
    "bench": "node bench.js"
  },
  "keywords": [
    "queue",
    "fifo",
    "linked-list",
    "data-structure",
    "javascript"
  ],
  "author": "Adarsha Khatua",
  "license": "MIT"
}
