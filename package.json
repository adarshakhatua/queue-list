{
  "name": "queue-list",
  "version": "2.3.1",
  "description": "A fast, dependency-free FIFO queue (circular buffer) for JavaScript with O(1) enqueue/dequeue, iteration support and TypeScript types",
  "type": "module",
  "sideEffects": false,
  "main": "index.cjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "index.d.cts"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build-cjs.js",
    "test": "node --test",
    "bench": "node bench.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "queue",
    "fifo",
    "ring-buffer",
    "data-structure",
    "javascript",
    "async-queue"
  ],
  "author": "Adarsha Khatua",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adarshakhatua/queue-list.git"
  },
  "bugs": {
    "url": "https://github.com/adarshakhatua/queue-list/issues"
  },
  "homepage": "https://github.com/adarshakhatua/queue-list#readme",
  "license": "MIT",
  "devDependencies": {
    "denque": "^2.1.0",
    "yocto-queue": "^1.2.2"
  }
}
